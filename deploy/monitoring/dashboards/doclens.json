{
  "uid": "doclens",
  "title": "DocLens Operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Service scrape status",
      "description": "1 means Prometheus can scrape this service; it does not prove the full user journey works.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"doclens|qdrant\"}",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Backend HTTP requests / second",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"doclens\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Upload responses by status / second",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"doclens\",handler=\"/documents/process\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Upload request duration p95",
      "description": "HTTP request timing, not durable job progress or a supported document-size guarantee.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"doclens\",handler=\"/documents/process\"}[$__rate_interval])))",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Successful logins / second",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(doclens_auth_login_success_total{job=\"doclens\"}[$__rate_interval])",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Failed logins / second",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(doclens_auth_login_failure_total{job=\"doclens\"}[$__rate_interval])",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Retrieval duration p95",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(doclens_rag_retrieval_duration_seconds_bucket{job=\"doclens\"}[$__rate_interval])))",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Gemini requests by outcome / second",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(doclens_gemini_requests_total{job=\"doclens\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Gemini duration p95",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(doclens_gemini_duration_seconds_bucket{job=\"doclens\"}[$__rate_interval])))",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Gemini reported tokens / second",
      "description": "Provider-reported token counts. Total overlaps prompt/completion; do not add these series together or infer billing cost.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(doclens_gemini_tokens_total{job=\"doclens\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Backend process memory",
      "description": "Only the API process. This is not whole-Pod memory or Docker container memory.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"doclens\"}",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Backend process CPU",
      "description": "Only the API process, not the entire host or Pod.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "doclens-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"doclens\"}[$__rate_interval])",
          "legendFormat": "{{job}} {{status}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "links": [
    {
      "title": "Back to DocLens",
      "url": "/dashboard",
      "targetBlank": false,
      "type": "link"
    }
  ]
}
