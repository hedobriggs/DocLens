{
  "name": "DocLens",
  "imageName": "REPLACE_WITH_REVIEWED_IMAGE_DIGEST",
  "isServerless": false,
  "containerDiskInGb": 15,
  "volumeInGb": 20,
  "volumeMountPath": "/workspace",
  "ports": "3000/http",
  "env": {
    "DOCLENS_ADMIN_EMAIL": "{{ RUNPOD_SECRET_doclens_admin_email }}",
    "DOCLENS_ADMIN_PASSWORD": "{{ RUNPOD_SECRET_doclens_admin_password }}",
    "GEMINI_API_KEY": "{{ RUNPOD_SECRET_doclens_gemini_key }}",
    "DOCLENS_MONITORING": "1"
  },
  "isPublic": false
}
