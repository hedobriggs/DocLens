# Copy to .env and chmod 600 .env before editing. Never commit the real file.
# Single-quote values containing dollar signs; values are never shell commands.
# Keep first-time image builds sequential on small Docker hosts.
COMPOSE_PARALLEL_LIMIT=1
GEMINI_API_KEY=replace-with-your-gemini-api-key
DOCLENS_ADMIN_EMAIL=replace-with-your-email
DOCLENS_ADMIN_PASSWORD='replace-with-a-strong-password'
